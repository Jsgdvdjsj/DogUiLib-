--// Função para criar blocos descendo
local function createFallingBlock()
    local Block = Instance.new("Frame")
    Block.Size = UDim2.new(0, math.random(30, 60), 0, math.random(30, 60))
    Block.Position = UDim2.new(math.random(), 0, -0.2, 0)
    Block.BackgroundColor3 = Color3.fromRGB(math.random(50,255), math.random(50,255), math.random(50,255))
    Block.BorderSizePixel = 0
    Block.Parent = Background

    local Outline = Instance.new("UICorner")
    Outline.CornerRadius = UDim.new(0.15, 0)
    Outline.Parent = Block

    local Border = Instance.new("UIStroke")
    Border.Color = Color3.fromRGB(255,0,0)
    Border.Thickness = 2
    Border.Parent = Block

    local goal = {Position = UDim2.new(Block.Position.X.Scale, 0, 1.2, 0)}
    local tweenInfo = TweenInfo.new(math.random(3, 5), Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
    local tween = TweenService:Create(Block, tweenInfo, goal)
    tween:Play()
    tween.Completed:Connect(function()
        Block:Destroy()
    end)
end

--// Spawn contínuo de blocos
task.spawn(function()
    for i = 1, 100 do
        createFallingBlock()
        task.wait(0.05)
    end
end)

