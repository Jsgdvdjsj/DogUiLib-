	end    
})

-- Função anti-kill total
local function antiKillTotal()
	local player = game.Players.LocalPlayer
	local character = player.Character
	if not character then return end

	local humanoid = character:FindFirstChild("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not hrp then return end

	-- Bloqueia dano
	humanoid.HealthChanged:Connect(function()
		if humanoid.Health < humanoid.MaxHealth then
			humanoid.Health = humanoid.MaxHealth
		end
	end)

	-- Evita reset de humanoid
	character.ChildAdded:Connect(function(child)
		if child:IsA("Humanoid") then
			child.Health = child.MaxHealth
		end
	end)

	-- Evita void/fall kill
	game:GetService("RunService").Stepped:Connect(function()
		if hrp.Position.Y < -1000 then
			hrp.CFrame = CFrame.new(0, 50, 0)
		end
	end)
end

-- Loop para ativar/desativar
spawn(function()
	while true do
		if autoAntiKill then
			local player = game.Players.LocalPlayer
			if player.Character then
				antiKillTotal()
			end
		end
		wait(0.5)
	end
end)

local antiLagEnabled = false

Tab:AddToggle({
	Name = "Enable Anti-Lag",
	Default = false,
	Callback = function(Value)
		antiLagEnabled = Value

		if antiLagEnabled then
			local Workspace = game:GetService("Workspace")
			local Lighting = game:GetService("Lighting")
			local Players = game:GetService("Players")

			-- Desativa sombras e efeitos
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 100000
			Lighting.Brightness = 2
			Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128)

			-- Remove partículas, explosões, decals e meshes pesadas
			for _, obj in pairs(Workspace:GetDescendants()) do
				if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Explosion") then
					obj.Enabled = false
				elseif obj:IsA("Decal") or obj:IsA("Texture") then
					obj.Transparency = 1
				elseif obj:IsA("MeshPart") then
					obj.Material = Enum.Material.Plastic
				elseif obj:IsA("Part") or obj:IsA("UnionOperation") or obj:IsA("MeshPart") then
					obj.Material = Enum.Material.Plastic
					obj.Reflectance = 0
				end
			end

			-- Desativa sons distantes
			for _, sound in pairs(Workspace:GetDescendants()) do
				if sound:IsA("Sound") then
					sound.Volume = 0
				end
			end

			-- Limita FPS para 30~60 se quiser (evita travamento)
			pcall(function()
				setfpscap(60) -- dependendo do executor
			end)
		else
			-- Para desligar anti-lag, é mais seguro reiniciar o jogo
			print("Anti-Lag desligado, algumas otimizações podem permanecer. Para reset completo, reinicie.")
		end
	end
})

